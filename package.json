{
  "name": "soulforge",
  "version": "0.39.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run check && pnpm run build && pnpm run check:cloudflare-build && wrangler deploy -c dist/soulforge/wrangler.json && pnpm run check:production",
    "db:migrate:local": "wrangler d1 migrations apply soulforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply soulforge --remote",
    "test": "pnpm run test:app && pnpm run test:worker",
    "test:app": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "artwork:derive": "python scripts/process-artwork.py",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:cloudflare-build": "node scripts/check-cloudflare-build.mjs",
    "check:production": "node scripts/check-cloudflare-production.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm run check:release && pnpm run check:architecture && tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.worker-test.json --noEmit && pnpm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@msw/cloudflare": "^0.2.0",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.5",
    "msw": "3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
