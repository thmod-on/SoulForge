{
  "name": "soulforge",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run check && pnpm run build && wrangler deploy -c dist/soulforge/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply soulforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply soulforge --remote",
    "test": "vitest run",
    "artwork:derive": "python scripts/process-artwork.py",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm run check:release && pnpm run check:architecture && tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vitest run"
  },
  "dependencies": {
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.148.0"
  }
}
