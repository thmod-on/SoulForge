{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soulforge",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SYNC_ENABLED": "true",
    "GOOGLE_CLIENT_ID": "641900044183-481lvp2rlb89r9614j6oqtgvmqovha2d.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulforge",
      "database_id": "73b03a37-b673-4600-b8ec-5e9f4707ebcc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "soulforge-media"
    }
  ]
}
